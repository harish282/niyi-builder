{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@niyi-builder/core": ["./builder/core/src/index.ts"],
      "@niyi-builder/editor": ["./builder/editor/src/index.ts"],
      "@niyi-builder/elements": ["./builder/elements/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "admin/src/**/*.ts",
    "admin/src/**/*.tsx",
    "builder/core/src/**/*.ts",
    "builder/editor/src/**/*.ts",
    "builder/editor/src/**/*.tsx",
    "builder/elements/src/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "builder/core/src/**/*.d.ts",
    "builder/editor/src/**/*.d.ts",
    "admin/src/**/*.d.ts"
  ]
}