{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@niyi-builder/core": ["../core/src/index.ts"],
      "@niyi-builder/serializer": ["../serializer/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../core" }, { "path": "../serializer" }, { "path": "../utils" }]
}
